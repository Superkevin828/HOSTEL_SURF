# Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Keep this one secret. It never goes in the frontend folder.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket for hostel photos (created by sql/schema.sql)
SUPABASE_BUCKET=hostel-images

PORT=4000

# Only needed when the frontend is hosted somewhere else (e.g. Cloudflare Pages).
# Comma-separated list of allowed origins, e.g. https://buhostels.pages.dev
CORS_ORIGIN=
